{
  "name": "house-console",
  "version": "0.1.0-alpha.1",
  "description": "A read-only operational console for House Runtime.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "private": false,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "scan:private": "house-privacy-scan . --exclude node_modules --exclude .git --exclude dist --exclude test-results --exclude playwright-report --english-only",
    "check": "npm test && npm run build && npm run scan:private"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "house-runtime": "github:rosie12056-afk/house-runtime#v0.3.0-rc.2",
    "house-toolkit": "github:rosie12056-afk/house-toolkit#v0.3.0-rc.3",
    "jsdom": "^26.1.0",
    "vite": "^6.1.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rosie12056-afk/house-console.git"
  }
}
